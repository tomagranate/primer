#!/bin/zsh
# primer -- CLI for managing your Mac setup
# https://github.com/tomagranate/primer
set -eo pipefail

# ── Configuration ─────────────────────────────────────────────────────────────

export REPO_URL="https://github.com/tomagranate/primer"
export REPO_RAW="https://raw.githubusercontent.com/tomagranate/primer/master"
export CONFIG_DIR="$HOME/.config"
export ZSH_CONFIG_DIR="$CONFIG_DIR/zsh"
export BIN_DIR="$HOME/bin"

typeset -g PRIMER_DIR=""   # Set after download or from PRIMER_LOCAL
typeset -g DRY_RUN=false
typeset -g PRIMER_SKIP=""  # Space-separated modules to skip (--skip <name>)
typeset -g PRIMER_ONLY=""  # Space-separated modules to run exclusively (--only <name>)
typeset -g PRIMER_UI_MODE=""  # auto-selected unless --tui or --log is passed
typeset -g PRIMER_PROFILE="${PRIMER_PROFILE:-}"

primer::download_with_spinner() {
    local label="$1"
    shift

    if [[ ! -t 2 ]]; then
        "$@"
        return
    fi

    local -a frames=('|' '/' '-' '\')
    local frame=1 pid result
    "$@" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        printf '\r  %s %s' "${frames[$frame]}" "$label" >&2
        frame=$(( frame % 4 + 1 ))
        sleep 0.1
    done
    if wait "$pid"; then
        result=0
    else
        result=$?
    fi
    if (( result == 0 )); then
        printf '\r  Primer binary download complete.\n' >&2
    else
        printf '\r  Primer binary download failed.\n' >&2
    fi
    return "$result"
}

# ── Framework Download ────────────────────────────────────────────────────────

primer::download_framework() {
    local cache="$HOME/.cache/primer"
    local staging previous=""

    mkdir -p "${cache:h}"

    # Extract into a fresh directory. This drops files deleted upstream.
    if ! staging="$(mktemp -d "${cache}.new.XXXXXX" 2>/dev/null)"; then
        print "  ✗  Failed to download primer framework" >&2
        print "     Could not create a staging directory in ${cache:h}." >&2
        return 1
    fi

    # Download the entire repo as a tarball and extract
    if ! curl -fsSL "$REPO_URL/archive/refs/heads/master.tar.gz" \
        | tar -xzf - -C "$staging" --strip-components=1 2>/dev/null; then
        rm -rf "$staging"
        print "  ✗  Failed to download primer framework" >&2
        print "     Check your internet connection and try again." >&2
        return 1
    fi

    # Swap the new copy in. Keep the old copy until the swap succeeds.
    if [[ -e "$cache" ]]; then
        previous="${cache}.old.$$"
        rm -rf "$previous"
        if ! mv "$cache" "$previous"; then
            rm -rf "$staging"
            print "  ✗  Failed to download primer framework" >&2
            print "     Could not replace: $cache" >&2
            return 1
        fi
    fi

    if ! mv "$staging" "$cache"; then
        if [[ -n "$previous" ]]; then
            mv "$previous" "$cache" 2>/dev/null || true
        fi
        rm -rf "$staging"
        print "  ✗  Failed to download primer framework" >&2
        print "     Could not replace: $cache" >&2
        return 1
    fi

    if [[ -n "$previous" ]]; then
        rm -rf "$previous"
    fi

    PRIMER_DIR="$cache"
}

primer::should_self_update() {
    [[ "$1" == "update" && "$DRY_RUN" != true && -z "$PRIMER_LOCAL" ]]
}

primer::self_update() {
    local target="${BIN_DIR}/primer"
    local tmp="${target}.tmp.$$"
    local url="${REPO_RAW}/bin/primer"

    mkdir -p "$BIN_DIR"

    if ! curl -fsSL "$url" -o "$tmp"; then
        rm -f "$tmp"
        print "  ✗  Failed to self-update primer CLI" >&2
        print "     Could not download: $url" >&2
        return 1
    fi

    if ! chmod +x "$tmp"; then
        rm -f "$tmp"
        print "  ✗  Failed to self-update primer CLI" >&2
        print "     Could not make executable: $tmp" >&2
        return 1
    fi

    if ! mv "$tmp" "$target"; then
        rm -f "$tmp"
        print "  ✗  Failed to self-update primer CLI" >&2
        print "     Could not replace: $target" >&2
        return 1
    fi
}

# ── Help ──────────────────────────────────────────────────────────────────────

primer::help() {
    cat <<'EOF'
primer -- machine setup manager

Usage:
  primer <command> [flags]

Commands:
  update      Install/update everything (idempotent)
  status      Check what's installed and healthy

Flags:
  --dry-run         Preview changes without applying them (update only)
  --skip <module>   Skip a module by name; repeatable (update only)
  --only <module>   Run only this module; repeatable (update only)
  --profile <name>  Force profile: mac, linux-vps, ubuntu-desktop
  --tui             Compatibility alias; TUI is already the default
  --log             Force plain log output
  --help            Show this help message

Examples:
  primer update                          # Run the full setup
  primer update --dry-run                # Preview what would happen
  primer update --skip mac-app-store     # Skip App Store installs
  primer update --only homebrew          # Run only homebrew
  primer update --profile linux-vps      # Run the Linux VPS profile
  primer update --log                    # Use headless output without the sidebar
  primer status                          # Check current state

Environment:
  PRIMER_LOCAL=/path/to/repo   Use a local checkout instead of GitHub
  PRIMER_PROFILE=linux-vps     Select profile without a flag
EOF
}

primer::run_app() {
    if [[ "${PRIMER_APP_SOURCE:-0}" == 1 ]]; then
        command -v bun >/dev/null 2>&1 || {
            print "PRIMER_APP_SOURCE requires Bun." >&2
            return 1
        }
        exec bun run "$PRIMER_DIR/app/src/index.tsx" "$@"
    fi

    local os arch asset release_base version cache_dir binary tmp expected actual
    case "$(uname -s 2>/dev/null)" in
        Darwin) os=darwin ;;
        Linux) os=linux ;;
        *) print "Unsupported OS for Primer binary: $(uname -s 2>/dev/null)" >&2; return 1 ;;
    esac
    case "$(uname -m 2>/dev/null)" in
        arm64|aarch64) arch=arm64 ;;
        x86_64|amd64) arch=x64 ;;
        *) print "Unsupported architecture for Primer binary: $(uname -m 2>/dev/null)" >&2; return 1 ;;
    esac

    asset="primer-${os}-${arch}"
    release_base="https://github.com/tomagranate/primer/releases/download/latest"
    version="$(curl -fsSL "$release_base/primer-version.txt")" || {
        print "Failed to resolve the latest Primer binary version." >&2
        return 1
    }
    [[ "$version" =~ '^[0-9a-f]{40}$' ]] || {
        print "Invalid Primer binary version: $version" >&2
        return 1
    }

    cache_dir="$HOME/.cache/primer/bin"
    binary="$cache_dir/${asset}-${version}"
    if [[ ! -x "$binary" ]]; then
        mkdir -p "$cache_dir"
        tmp="$(mktemp "$cache_dir/${asset}.XXXXXX")" || return 1
        if ! primer::download_with_spinner "Downloading Primer binary..." \
            curl -fsSL "$release_base/$asset" -o "$tmp"; then
            rm -f "$tmp"
            print "Failed to download $asset." >&2
            return 1
        fi
        expected="$(curl -fsSL "$release_base/${asset}.sha256" | awk '{print $1}')" || {
            rm -f "$tmp"
            return 1
        }
        if command -v shasum >/dev/null 2>&1; then
            actual="$(shasum -a 256 "$tmp" | awk '{print $1}')"
        elif command -v sha256sum >/dev/null 2>&1; then
            actual="$(sha256sum "$tmp" | awk '{print $1}')"
        else
            rm -f "$tmp"
            print "A SHA-256 checksum tool is required." >&2
            return 1
        fi
        if [[ -z "$expected" || "$actual" != "$expected" ]]; then
            rm -f "$tmp"
            print "Checksum verification failed for $asset." >&2
            return 1
        fi
        chmod +x "$tmp"
        mv "$tmp" "$binary"
    fi

    exec "$binary" "$@"
}

# ── Profile Detection ────────────────────────────────────────────────────────

# List the profile names that have a config file on disk.
primer::available_profiles() {
    local file
    for file in "$PRIMER_DIR"/configs/profiles/*.conf(N); do
        print -r -- "${${file:t}%.conf}"
    done
}

# A profile is valid when configs/profiles/<name>.conf exists.
primer::profile_valid() {
    local name="$1"
    [[ -n "$name" && "$name" != *"/"* && "$name" != .* ]] || return 1
    [[ -f "$PRIMER_DIR/configs/profiles/${name}.conf" ]]
}

primer::uname() {
    if [[ -n "${PRIMER_TEST_UNAME:-}" ]]; then
        print -r -- "$PRIMER_TEST_UNAME"
    else
        uname -s 2>/dev/null || print unknown
    fi
}

primer::os_release_file() {
    if [[ -n "${PRIMER_OS_RELEASE_FILE:-}" ]]; then
        print -r -- "$PRIMER_OS_RELEASE_FILE"
    else
        print /etc/os-release
    fi
}

primer::os_release_value() {
    local key="$1" file
    file="$(primer::os_release_file)"
    [[ -f "$file" ]] || return 1
    awk -F= -v key="$key" '
        $1 == key {
            value = $2
            gsub(/^"/, "", value)
            gsub(/"$/, "", value)
            print value
            exit
        }
    ' "$file"
}

primer::linux_desktop() {
    local desktop="${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-}}"
    [[ -n "$desktop" ]]
}

primer::linux_vps_signal() {
    local id="${1:l}" id_like="${2:l}"
    if [[ "$id" == debian || "$id" == ubuntu || "$id_like" == *debian* || "$id_like" == *ubuntu* ]]; then
        [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" && -z "${XDG_CURRENT_DESKTOP:-}" ]] && return 0
    fi
    return 1
}

primer::prompt_linux_profile() {
    local input="/dev/stdin" answer
    [[ ! -t 0 ]] && input="/dev/tty"

    print "" >/dev/tty
    print "Primer could not safely infer this Linux machine's profile." >/dev/tty
    print -n "Use linux-vps? [Y/n] " >/dev/tty
    IFS= read -r answer < "$input" || answer=""
    answer="${answer:l}"
    case "$answer" in
        ""|y|yes) print linux-vps ;;
        n|no) print ubuntu-desktop ;;
        *) print linux-vps ;;
    esac
}

primer::detect_profile() {
    if [[ -n "$PRIMER_PROFILE" ]]; then
        if primer::profile_valid "$PRIMER_PROFILE"; then
            print -r -- "$PRIMER_PROFILE"
            return 0
        fi
        local -a available
        available=("${(@f)$(primer::available_profiles)}")
        available=("${(@)available:#}")
        print "Unknown profile: $PRIMER_PROFILE" >&2
        if (( ${#available} )); then
            print "Valid profiles: ${(j:, :)available}" >&2
        else
            print "No profile configs found in: $PRIMER_DIR/configs/profiles" >&2
        fi
        return 1
    fi

    local os id id_like
    os="$(primer::uname)"
    case "$os" in
        Darwin)
            print mac
            return 0
            ;;
        Linux)
            id="$(primer::os_release_value ID 2>/dev/null || true)"
            id_like="$(primer::os_release_value ID_LIKE 2>/dev/null || true)"
            if [[ "${id:l}" == ubuntu ]] && primer::linux_desktop; then
                print ubuntu-desktop
                return 0
            fi
            if primer::linux_vps_signal "$id" "$id_like"; then
                print linux-vps
                return 0
            fi
            if primer::has_prompt_tty; then
                primer::prompt_linux_profile
                return 0
            fi
            print "Could not infer Linux profile non-interactively." >&2
            print "Run with --profile linux-vps or --profile ubuntu-desktop." >&2
            return 1
            ;;
        *)
            print "Unsupported OS: $os" >&2
            return 1
            ;;
    esac
}

primer::config_files_for_profile() {
    local profile="$1"
    local common="$PRIMER_DIR/configs/common.conf"
    local profile_conf="$PRIMER_DIR/configs/profiles/${profile}.conf"

    [[ -f "$common" ]] || {
        print "Missing config file: $common" >&2
        return 1
    }
    [[ -f "$profile_conf" ]] || {
        print "Missing config for profile: $profile" >&2
        return 1
    }

    print -r -- "$common"
    print -r -- "$profile_conf"
    return 0
}

# ── Main ──────────────────────────────────────────────────────────────────────

main() {
    local command="" arg
    for arg in "$@"; do
        [[ "$arg" == "update" || "$arg" == "status" ]] && command="$arg"
        [[ "$arg" == "--dry-run" ]] && DRY_RUN=true
    done

    # Keep the launcher itself current before running update.
    if primer::should_self_update "$command" && [[ "${PRIMER_SELF_UPDATED:-0}" != 1 ]]; then
        primer::self_update || return 1
        export PRIMER_SELF_UPDATED=1
        exec "${BIN_DIR}/primer" "$@"
    fi

    # Load framework (local or remote)
    if [[ -n "$PRIMER_LOCAL" ]]; then
        PRIMER_DIR="$PRIMER_LOCAL"
    else
        primer::download_framework || return 1
    fi
    export PRIMER_DIR

    # The TypeScript app is Primer's sole execution path. It selects the
    # sidebar TUI on a terminal and headless output when no TTY is available.
    primer::run_app "$@"
}

if [[ -z "${PRIMER_SOURCE_ONLY:-}" ]]; then
    main "$@"
fi
