#!/bin/zsh
# primer -- CLI for managing your Mac setup
# https://github.com/tomagranate/primer
set -eo pipefail

# ── Configuration ─────────────────────────────────────────────────────────────

export REPO_URL="https://github.com/tomagranate/primer"
export REPO_RAW="https://raw.githubusercontent.com/tomagranate/primer/main"
export CONFIG_DIR="$HOME/.config"
export ZSH_CONFIG_DIR="$CONFIG_DIR/zsh"
export BIN_DIR="$HOME/bin"

typeset -g PRIMER_DIR=""   # Set after download or from PRIMER_LOCAL
typeset -g DRY_RUN=false
typeset -g PRIMER_SKIP=""  # Space-separated modules to skip (--skip <name>)
typeset -g PRIMER_ONLY=""  # Space-separated modules to run exclusively (--only <name>)
typeset -g PRIMER_UI_MODE=""  # auto-selected unless --tui or --log is passed
typeset -g PRIMER_PROFILE="${PRIMER_PROFILE:-}"

# ── Framework Download ────────────────────────────────────────────────────────

primer::download_framework() {
    local cache="$HOME/.cache/primer"
    mkdir -p "$cache"

    # Download the entire repo as a tarball and extract
    if ! curl -fsSL "$REPO_URL/archive/refs/heads/main.tar.gz" \
        | tar -xzf - -C "$cache" --strip-components=1 2>/dev/null; then
        print "  ✗  Failed to download primer framework" >&2
        print "     Check your internet connection and try again." >&2
        return 1
    fi

    PRIMER_DIR="$cache"
}

primer::should_self_update() {
    [[ "$1" == "update" && "$DRY_RUN" != true && -z "$PRIMER_LOCAL" ]]
}

primer::self_update() {
    local target="${BIN_DIR}/primer"
    local tmp="${target}.tmp.$$"
    local url="${REPO_RAW}/bin/primer"

    mkdir -p "$BIN_DIR"

    if ! curl -fsSL "$url" -o "$tmp"; then
        rm -f "$tmp"
        print "  ✗  Failed to self-update primer CLI" >&2
        print "     Could not download: $url" >&2
        return 1
    fi

    if ! chmod +x "$tmp"; then
        rm -f "$tmp"
        print "  ✗  Failed to self-update primer CLI" >&2
        print "     Could not make executable: $tmp" >&2
        return 1
    fi

    if ! mv "$tmp" "$target"; then
        rm -f "$tmp"
        print "  ✗  Failed to self-update primer CLI" >&2
        print "     Could not replace: $target" >&2
        return 1
    fi
}

# ── Help ──────────────────────────────────────────────────────────────────────

primer::help() {
    cat <<'EOF'
primer -- machine setup manager

Usage:
  primer <command> [flags]

Commands:
  update      Install/update everything (idempotent)
  status      Check what's installed and healthy

Flags:
  --dry-run         Preview changes without applying them (update only)
  --skip <module>   Skip a module by name; repeatable (update only)
  --only <module>   Run only this module; repeatable (update only)
  --profile <name>  Force profile: mac, linux-vps, ubuntu-budgie
  --tui             Force alternate-screen terminal UI (update only)
  --log             Force plain log output
  --help            Show this help message

Examples:
  primer update                          # Run the full setup
  primer update --dry-run                # Preview what would happen
  primer update --skip mac-app-store     # Skip App Store installs
  primer update --only homebrew          # Run only homebrew
  primer update --profile linux-vps      # Run the Linux VPS profile
  primer update --log                    # Print progress and logs without a TUI
  primer status                          # Check current state

Environment:
  PRIMER_LOCAL=/path/to/repo   Use a local checkout instead of GitHub
  PRIMER_PROFILE=linux-vps     Select profile without a flag
EOF
}

# ── Profile Detection ────────────────────────────────────────────────────────

primer::profile_valid() {
    case "$1" in
        mac|linux-vps|ubuntu-budgie) return 0 ;;
        *) return 1 ;;
    esac
}

primer::uname() {
    if [[ -n "${PRIMER_TEST_UNAME:-}" ]]; then
        print -r -- "$PRIMER_TEST_UNAME"
    else
        uname -s 2>/dev/null || print unknown
    fi
}

primer::os_release_file() {
    if [[ -n "${PRIMER_OS_RELEASE_FILE:-}" ]]; then
        print -r -- "$PRIMER_OS_RELEASE_FILE"
    else
        print /etc/os-release
    fi
}

primer::os_release_value() {
    local key="$1" file
    file="$(primer::os_release_file)"
    [[ -f "$file" ]] || return 1
    awk -F= -v key="$key" '
        $1 == key {
            value = $2
            gsub(/^"/, "", value)
            gsub(/"$/, "", value)
            print value
            exit
        }
    ' "$file"
}

primer::linux_budgie_desktop() {
    local desktop="${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-}}"
    [[ "${desktop:l}" == *budgie* ]]
}

primer::linux_vps_signal() {
    local id="${1:l}" id_like="${2:l}"
    if [[ "$id" == debian || "$id" == ubuntu || "$id_like" == *debian* || "$id_like" == *ubuntu* ]]; then
        [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" && -z "${XDG_CURRENT_DESKTOP:-}" ]] && return 0
    fi
    return 1
}

primer::has_prompt_tty() {
    [[ -t 0 ]] && return 0
    [[ -e /dev/tty ]] || return 1
    ( : </dev/tty >/dev/tty ) 2>/dev/null
}

primer::prompt_linux_profile() {
    local input="/dev/stdin" answer
    [[ ! -t 0 ]] && input="/dev/tty"

    print "" >/dev/tty
    print "Primer could not safely infer this Linux machine's profile." >/dev/tty
    print -n "Use linux-vps? [Y/n] " >/dev/tty
    IFS= read -r answer < "$input" || answer=""
    answer="${answer:l}"
    case "$answer" in
        ""|y|yes) print linux-vps ;;
        n|no) print ubuntu-budgie ;;
        *) print linux-vps ;;
    esac
}

primer::detect_profile() {
    if [[ -n "$PRIMER_PROFILE" ]]; then
        if primer::profile_valid "$PRIMER_PROFILE"; then
            print -r -- "$PRIMER_PROFILE"
            return 0
        fi
        print "Unknown profile: $PRIMER_PROFILE" >&2
        print "Valid profiles: mac, linux-vps, ubuntu-budgie" >&2
        return 1
    fi

    local os id id_like
    os="$(primer::uname)"
    case "$os" in
        Darwin)
            print mac
            return 0
            ;;
        Linux)
            id="$(primer::os_release_value ID 2>/dev/null || true)"
            id_like="$(primer::os_release_value ID_LIKE 2>/dev/null || true)"
            if [[ "${id:l}" == ubuntu ]] && primer::linux_budgie_desktop; then
                print ubuntu-budgie
                return 0
            fi
            if primer::linux_vps_signal "$id" "$id_like"; then
                print linux-vps
                return 0
            fi
            if primer::has_prompt_tty; then
                primer::prompt_linux_profile
                return 0
            fi
            print "Could not infer Linux profile non-interactively." >&2
            print "Run with --profile linux-vps or --profile ubuntu-budgie." >&2
            return 1
            ;;
        *)
            print "Unsupported OS: $os" >&2
            return 1
            ;;
    esac
}

primer::config_files_for_profile() {
    local profile="$1"
    local common="$PRIMER_DIR/configs/common.conf"
    local profile_conf="$PRIMER_DIR/configs/profiles/${profile}.conf"

    if [[ -f "$common" && -f "$profile_conf" ]]; then
        print -r -- "$common"
        print -r -- "$profile_conf"
        return 0
    fi

    if [[ "$profile" == mac && -f "$PRIMER_DIR/primer.conf" ]]; then
        print -r -- "$PRIMER_DIR/primer.conf"
        return 0
    fi

    print "Missing config for profile: $profile" >&2
    return 1
}

# ── Main ──────────────────────────────────────────────────────────────────────

main() {
    local command=""

    # Parse arguments
    while (( $# > 0 )); do
        case "$1" in
            update|status)  command="$1" ;;
            --dry-run)      DRY_RUN=true ;;
            --tui)          PRIMER_UI_MODE="alternate" ;;
            --log)          PRIMER_UI_MODE="log" ;;
            --profile)
                if [[ -z "${2:-}" || "${2:-}" == --* ]]; then
                    print "Missing argument for --profile" >&2
                    print "Run 'primer --help' for usage." >&2
                    return 1
                fi
                PRIMER_PROFILE="$2"; shift ;;
            --skip)
                if [[ -z "${2:-}" || "${2:-}" == --* ]]; then
                    print "Missing argument for --skip" >&2
                    print "Run 'primer --help' for usage." >&2
                    return 1
                fi
                PRIMER_SKIP="${PRIMER_SKIP:+$PRIMER_SKIP }$2"; shift ;;
            --only)
                if [[ -z "${2:-}" || "${2:-}" == --* ]]; then
                    print "Missing argument for --only" >&2
                    print "Run 'primer --help' for usage." >&2
                    return 1
                fi
                PRIMER_ONLY="${PRIMER_ONLY:+$PRIMER_ONLY }$2"; shift ;;
            --help|-h|help) primer::help; return 0 ;;
            *)
                print "Unknown argument: $1" >&2
                print "Run 'primer --help' for usage." >&2
                return 1
                ;;
        esac
        shift
    done

    if [[ -z "$command" ]]; then
        primer::help
        return 0
    fi

    if [[ (-n "$PRIMER_SKIP" || -n "$PRIMER_ONLY") && "$command" != "update" ]]; then
        print -- "--skip and --only are only valid with 'update'." >&2
        return 1
    fi

    if [[ "$PRIMER_UI_MODE" == "alternate" && "$command" != "update" ]]; then
        print -- "--tui is only valid with 'update'." >&2
        return 1
    fi

    if [[ -n "$PRIMER_SKIP" && -n "$PRIMER_ONLY" ]]; then
        print -- "--skip and --only cannot be used together." >&2
        return 1
    fi

    export DRY_RUN
    export PRIMER_SKIP
    export PRIMER_ONLY
    export PRIMER_UI_MODE

    # Keep the launcher itself current before running update.
    if primer::should_self_update "$command"; then
        primer::self_update || return 1
    fi

    # Load framework (local or remote)
    if [[ -n "$PRIMER_LOCAL" ]]; then
        PRIMER_DIR="$PRIMER_LOCAL"
    else
        primer::download_framework || return 1
    fi
    export PRIMER_DIR

    # Source engine and UI
    source "$PRIMER_DIR/lib/ui.zsh"
    source "$PRIMER_DIR/lib/engine.zsh"

    PRIMER_PROFILE="$(primer::detect_profile)" || return 1
    export PRIMER_PROFILE

    local config_output config_files=()
    config_output="$(primer::config_files_for_profile "$PRIMER_PROFILE")" || return 1
    config_files=("${(@f)config_output}")

    # Load the DAG config
    engine::load_config "${config_files[@]}"

    # Dispatch
    case "$command" in
        update) engine::run_update ;;
        status) engine::run_status ;;
    esac
}

if [[ -z "${PRIMER_SOURCE_ONLY:-}" ]]; then
    main "$@"
fi
