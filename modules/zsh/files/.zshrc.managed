# >>> PRIMER MANAGED START (modules/zsh/files/.zshrc.managed) >>>
# ---- Path updates ----
typeset -U path PATH
path=(
  "$HOME/bin"
  "$HOME/.local/bin"
  "$HOME/.opencode/bin"
  "$HOME/.mise/bin"
  "$HOME/.local/share/mise/shims"
  "$HOME/.bun/bin"
  $path
)

# ------- Zim Setup -------

# Initialize zim
ZIM_HOME=~/.zim

# Download zimfw plugin manager if missing
if [[ ! -e ${ZIM_HOME}/zimfw.zsh ]]; then
  curl -fsSL --create-dirs -o ${ZIM_HOME}/zimfw.zsh \
      https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh
fi

# Install missing modules, and update ${ZIM_HOME}/init.zsh if missing or outdated
if [[ ! ${ZIM_HOME}/init.zsh -nt ${ZIM_CONFIG_FILE:-${ZDOTDIR:-${HOME}}/.zimrc} ]]; then
  zsh ${ZIM_HOME}/zimfw.zsh install
fi

# Initialize modules.
source ${ZIM_HOME}/init.zsh

# ---- Configuration ----
# history
HISTFILE=~/.zsh_history
export HISTSIZE=10000000
export SAVEHIST=10000000
setopt appendhistory

# ghostty fix
export TERM=xterm-256color

# zsh-history-substring-search
export HISTORY_SUBSTRING_SEARCH_ENSURE_UNIQUE=1

# fzf
export FZF_DEFAULT_COMMAND="rg --files --hidden --glob '!.git'"
export FZF_DEFAULT_OPTS="--layout=reverse --style=full --border --ansi"

# ---- Aliases ----
command -v eza >/dev/null 2>&1 && alias ls="eza"
alias ll="ls -lah"
command -v dust >/dev/null 2>&1 && alias du="dust"
command -v duf >/dev/null 2>&1 && alias df="duf"
command -v htop >/dev/null 2>&1 && alias top="htop"
alias docker-kill-all='docker stop $(docker ps -q) && docker rm $(docker ps -aq)'
port() { lsof -i -P | grep LISTEN | grep "$1" }
alias editrc="nvim ~/.zshrc"

rgf() {
  local bat_command="bat"
  command -v bat >/dev/null 2>&1 || bat_command="batcat"
  rg --color=always --line-number --no-heading --smart-case "${*:-}" |
  fzf --ansi \
      --color "hl:-1:underline,hl+:-1:underline:reverse" \
      --delimiter : \
      --preview "${bat_command} --color=always {1} --highlight-line {2}" \
      --preview-window 'right,70%,border-bottom,+{2}+3/3,~3' \
      --bind 'enter:become(code {1})'
}

# ---- pnpm ----
if [[ "$(uname -s 2>/dev/null)" == Darwin ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
else
  export PNPM_HOME="$HOME/.local/share/pnpm"
fi
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# ---- Mise ----
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"

# ---- agents update check ----
command -v agents >/dev/null 2>&1 && agents _shell-check

# ---- bun completions ----
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# ---- Android dev ----
if [[ "$(uname -s 2>/dev/null)" == Darwin ]]; then
  export ANDROID_HOME=$HOME/Library/Android/sdk
  path+=$ANDROID_HOME/emulator
  PATH=$PATH:$ANDROID_HOME/platform-tools
fi
# <<< PRIMER MANAGED END (modules/zsh/files/.zshrc.managed) <<<
