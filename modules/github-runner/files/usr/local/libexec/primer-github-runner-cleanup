#!/bin/sh
# Drop leftover review containers and root-owned review files for one runner.
#
# A job container is a leftover when it mounts this instance's work tree. We
# match on the mount, not on the image: the image tag is mutable and the
# configured image never reaches this helper.
set -eu

instance="${1:-}"
home="${GITHUB_RUNNER_HOME:-/var/lib/github-runner}"
user="${GITHUB_RUNNER_USER:-gha-runner}"

case "$instance" in
    ''|.|..|*/*)
        echo "usage: primer-github-runner-cleanup <instance>" >&2
        exit 2
        ;;
esac

work="$home/$instance/_work"

if command -v docker >/dev/null 2>&1 && [ -d "$work" ]; then
    docker ps -aq | while IFS= read -r cid; do
        [ -n "$cid" ] || continue
        docker inspect -f '{{range .Mounts}}{{.Source}}{{"\n"}}{{end}}' "$cid" 2>/dev/null \
            | grep -F "$work" >/dev/null 2>&1 || continue
        docker rm -f "$cid" >/dev/null 2>&1 || true
    done
fi

if [ -d "$work" ]; then
    find "$work" -depth \( -name '.jbot-review' -o -name 'jbot-shard-cache' \) \
        -exec rm -rf {} + 2>/dev/null || true
    chown -R "$user:$user" "$work" 2>/dev/null || true
fi
