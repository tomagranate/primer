[Unit]
Description=GitHub Actions runner (%i)
Documentation=https://docs.github.com/en/actions/hosting-your-own-runners
After=network-online.target docker.socket
Wants=network-online.target docker.socket

[Service]
Type=simple
User=gha-runner
Group=gha-runner
SupplementaryGroups=docker
WorkingDirectory=/var/lib/github-runner/%i
ExecStartPre=-+/usr/local/libexec/primer-github-runner-cleanup %i
ExecStart=/var/lib/github-runner/%i/run.sh
ExecStopPost=-+/usr/local/libexec/primer-github-runner-cleanup %i
Restart=always
RestartSec=10
TimeoutStopSec=30
CPUWeight=50
MemoryMax=8G
Slice=gha-runner.slice
UMask=0000
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/github-runner
Environment=HOME=/var/lib/github-runner
Environment=USER=gha-runner
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1

[Install]
WantedBy=multi-user.target
