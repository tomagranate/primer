#!/bin/sh
# Mock brew -- logs invocations and exits 0
#
# Configurable via environment variables:
#   MOCK_BREW_INSTALLED_TAPS      space-separated list of already-tapped repos
#   MOCK_BREW_INSTALLED_FORMULAE  space-separated list of installed formulae
#   MOCK_BREW_OUTDATED_FORMULAE   space-separated list of outdated formulae
#   MOCK_BREW_INSTALLED_CASKS     space-separated list of installed casks
#   MOCK_BREW_OUTDATED_CASKS      space-separated list of outdated casks
#   MOCK_BREW_FAIL_PACKAGES       space-separated list of packages that should fail
#   MOCK_BREW_LOCK_ONCE_PACKAGES  space-separated packages that should fail
#                                  once with a Homebrew lock error, then pass
#   MOCK_BREW_LOCK_STATE_DIR      directory for lock-once marker files
#   MOCK_BREW_UNTRUSTED_ONCE_PACKAGES space-separated packages that should fail
#                                  once with an untrusted tap warning, then pass
#   MOCK_BREW_EXISTING_APP_PACKAGES space-separated casks that fail with
#                                  "already an App at '/Applications/...'"
#   MOCK_BREW_CONCURRENCY_FILE    file prefix used to record max concurrent
#                                  install/upgrade invocations
#   MOCK_BREW_SLEEP               seconds to sleep during install/upgrade

case "$1" in
    --version)
        echo "Homebrew 4.0.0-mock"
        exit 0
        ;;
    tap)
        if [ $# -eq 1 ]; then
            # brew tap (no args) -- list installed taps
            printf '%s\n' $MOCK_BREW_INSTALLED_TAPS
            exit 0
        fi
        ;;
    list)
        case "${2:-}" in
            --formula) printf '%s\n' $MOCK_BREW_INSTALLED_FORMULAE; exit 0 ;;
            --cask)    printf '%s\n' $MOCK_BREW_INSTALLED_CASKS;    exit 0 ;;
        esac
        ;;
    outdated)
        case "${2:-}" in
            --formula) printf '%s\n' $MOCK_BREW_OUTDATED_FORMULAE; exit 0 ;;
            --cask)    printf '%s\n' $MOCK_BREW_OUTDATED_CASKS;    exit 0 ;;
        esac
        ;;
esac

# Log this invocation
echo "brew $*" >> "${MOCK_LOG:-/dev/null}"

brew_mock_lock() {
    lock="$1.lock"
    while ! mkdir "$lock" 2>/dev/null; do
        sleep 0.01
    done
}

brew_mock_unlock() {
    rmdir "$1.lock" 2>/dev/null || true
}

brew_mock_concurrency_enter() {
    file="$1"
    brew_mock_lock "$file"
    count=0
    max=0
    [ -f "$file.count" ] && count=$(cat "$file.count")
    [ -f "$file.max" ] && max=$(cat "$file.max")
    count=$(( count + 1 ))
    [ "$count" -gt "$max" ] && max="$count"
    echo "$count" > "$file.count"
    echo "$max" > "$file.max"
    brew_mock_unlock "$file"
}

brew_mock_concurrency_exit() {
    file="$1"
    brew_mock_lock "$file"
    count=0
    [ -f "$file.count" ] && count=$(cat "$file.count")
    [ "$count" -gt 0 ] && count=$(( count - 1 ))
    echo "$count" > "$file.count"
    brew_mock_unlock "$file"
}

case "$1" in
    install|upgrade)
        if [ -n "${MOCK_BREW_CONCURRENCY_FILE:-}" ]; then
            brew_mock_concurrency_enter "$MOCK_BREW_CONCURRENCY_FILE"
            trap 'brew_mock_concurrency_exit "$MOCK_BREW_CONCURRENCY_FILE"' EXIT
            sleep "${MOCK_BREW_SLEEP:-0.05}"
        fi
        ;;
esac

# Simulate brew cask conflict where app already exists in /Applications.
if [ "$1" = "install" ] && [ -n "${MOCK_BREW_EXISTING_APP_PACKAGES:-}" ]; then
    is_cask=false
    pkg=""
    for arg in "$@"; do
        [ "$arg" = "--cask" ] && is_cask=true && continue
        case "$arg" in
            -*|install) ;;
            *) pkg="$arg" ;;
        esac
    done
    [ "$is_cask" = true ] || pkg=""
    case " ${MOCK_BREW_EXISTING_APP_PACKAGES} " in
        *" ${pkg} "*)
            echo "Error: It seems there is already an App at '/Applications/${pkg}.app'." >&2
            exit 1
            ;;
    esac
fi

# Simulate a transient Homebrew lock failure for specific packages.
if [ -n "${MOCK_BREW_LOCK_ONCE_PACKAGES:-}" ]; then
    eval "last_arg=\$$#"
    case " ${MOCK_BREW_LOCK_ONCE_PACKAGES} " in
        *" ${last_arg} "*)
            state_dir="${MOCK_BREW_LOCK_STATE_DIR:-${TMPDIR:-/tmp}}"
            safe_name=$(printf '%s' "$last_arg" | tr '/:' '__')
            marker="${state_dir}/brew-lock-once-${safe_name}"
            if [ ! -f "$marker" ]; then
                mkdir -p "$state_dir"
                : > "$marker"
                echo "Error: A \`brew install ${last_arg}\` process has already locked /opt/homebrew/Cellar/ca-certificates." >&2
                echo "  Please wait for it to finish or terminate it to continue." >&2
                exit 1
            fi
            ;;
    esac
fi

# Simulate a first-run failure caused by tap trust state not being settled yet.
if [ -n "${MOCK_BREW_UNTRUSTED_ONCE_PACKAGES:-}" ]; then
    eval "last_arg=\$$#"
    case " ${MOCK_BREW_UNTRUSTED_ONCE_PACKAGES} " in
        *" ${last_arg} "*)
            state_dir="${MOCK_BREW_LOCK_STATE_DIR:-${TMPDIR:-/tmp}}"
            safe_name=$(printf '%s' "$last_arg" | tr '/:' '__')
            marker="${state_dir}/brew-untrusted-once-${safe_name}"
            if [ ! -f "$marker" ]; then
                mkdir -p "$state_dir"
                : > "$marker"
                echo "Warning: Skipping owner/tap because it is not trusted. Run \`brew trust owner/tap\` to trust it." >&2
                exit 1
            fi
            ;;
    esac
fi

# Simulate failure for specific packages (last argument is the package name)
if [ -n "${MOCK_BREW_FAIL_PACKAGES:-}" ]; then
    eval "last_arg=\$$#"
    case " ${MOCK_BREW_FAIL_PACKAGES} " in
        *" ${last_arg} "*) exit 1 ;;
    esac
fi

exit 0
