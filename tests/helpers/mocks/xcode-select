#!/bin/sh
# Mock xcode-select -- logs invocations
echo "xcode-select $*" >> "${MOCK_LOG:-/dev/null}"

installed=1
if [ "${MOCK_XCODE_MISSING:-0}" = "1" ]; then
    installed=0
fi
if [ -n "${MOCK_XCODE_INSTALL_MARKER:-}" ] && [ -f "$MOCK_XCODE_INSTALL_MARKER" ]; then
    installed=1
fi

# Simulate already-installed by default; set MOCK_XCODE_MISSING=1 to simulate missing
if [ "$installed" = "0" ]; then
    case "$1" in
        -p) exit 2 ;;   # not installed
        --install)
            [ -n "${MOCK_XCODE_INSTALL_MARKER:-}" ] && : > "$MOCK_XCODE_INSTALL_MARKER"
            exit 0
            ;;
    esac
else
    case "$1" in
        -p)
            if [ "${MOCK_XCODE_FULL:-0}" = "1" ]; then
                echo "/Applications/Xcode.app/Contents/Developer"
            else
                echo "/Library/Developer/CommandLineTools"
            fi
            exit 0
            ;;
        --install) exit 0 ;;
    esac
fi

exit 0
